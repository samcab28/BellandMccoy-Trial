# =============================================================================
# bellandmccoy-trial — Environment configuration TEMPLATE
# -----------------------------------------------------------------------------
# 1. Copy this file:           cp .env.example .env
# 2. Generate the secrets:     ./scripts/generate-secrets.sh
#    (or fill them in by hand using the guidance in each comment)
# 3. NEVER commit the real .env — it is git-ignored.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=bmc_app
# Use a long random string. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=bmc_sales

# --- Ollama ------------------------------------------------------------------
# Model used for structured extraction.
#   llama3.2:3b    -> ~2.0 GB, best quality. Default.
#   llama3.2:1b    -> ~1.3 GB, reliable JSON, lower RAM.
#   qwen2.5:0.5b   -> ~400 MB, lowest RAM, more fragile JSON.
OLLAMA_MODEL=llama3.2:3b

# --- n8n ---------------------------------------------------------------------
# 32+ char key used to encrypt stored credentials at rest.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_32_byte_hex_key

# Host/URL the BROWSER uses to reach n8n. For local-only use, leave as-is.
# If you tunnel (cloudflared/ngrok) for remote approval, set both to the
# public URL, e.g. https://your-tunnel.trycloudflare.com
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# --- Misc --------------------------------------------------------------------
GENERIC_TIMEZONE=America/Costa_Rica
