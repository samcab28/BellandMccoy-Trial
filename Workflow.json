        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n    \"model\": \"llama3.2:3b\",\n    \"stream\": false,\n    \"format\": \"json\",\n    \"messages\": [\n        {\n            \"role\": \"system\",\n            \"content\": \"You are a data extraction assistant. Extract fields from sales call transcripts and return ONLY valid JSON, no explanation, no markdown.\"\n        },\n        {\n            \"role\": \"user\",\n            \"content\": \"Extract these fields from the sales call transcript below.\\n\\nSTRICT RULES:\\n- Return ONLY a raw JSON object, no explanation, no markdown\\n- account_name: a BUSINESS or COMPANY name (e.g. 'Brightline Electric', 'ABC Corp'). A person's first name like 'Danny' is NEVER a company. If no business name is mentioned, return null\\n- contact_name: the caller or customer's personal name (e.g. 'Danny', 'Marcus'). If not mentioned, return null\\n- summary: 2-3 sentences describing what was discussed. If too vague, return null\\n- action_items: concrete next steps mentioned. Empty array [] if none\\n- order_intent: specific products, quantities or pricing discussed. null if none\\n- missing_fields: list the names of fields you set to null\\n- order_intent: a plain text description of products, quantities or pricing (e.g. '40 wireless dimmers and 40 wall stations, quote requested'). NEVER return an object or JSON, only a simple string or null\\n- needs_followup: true if critical info is missing or caller was vague\\n\\nTranscript:\\n{{ $json.body.transcript }}\"\n        }\n    ]\n}\n",
        "options": {}
      },
