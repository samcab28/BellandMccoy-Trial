        "html": "=<h2>New Transcript for Review</h2>\n\n<p><b>Company:</b> {{ $json.account_name }}</p>\n<p><b>Contact:</b> {{ $json.contact_name }}</p>\n<p><b>Summary:</b> {{ $json.summary }}</p>\n<p><b>Action Items:</b> {{ $json.action_items.join(', ') }}</p>\n<p><b>Order Intent:</b> {{ $json.order_intent ?? 'N/A' }}</p>\n\n<br>\n<a href=\"{{ $execution.resumeUrl }}&approved=true\" \n   style=\"background:green;color:white;padding:10px 20px;text-decoration:none;border-radius:5px;\">\n   ✅ APPROVE\n</a>\n&nbsp;&nbsp;\n<a href=\"{{ $execution.resumeUrl }}&approved=false\"\n   style=\"background:red;color:white;padding:10px 20px;text-decoration:none;border-radius:5px;\">\n   ❌ REJECT\n</a>\n",
