    {
      "parameters": {
        "jsCode": "const content = $input.first().json.message.content;\nconst parsed = JSON.parse(content);\n\n// Normalize order_intent to readable string or null\nif (parsed.order_intent && typeof parsed.order_intent === 'object') {\n  const items = parsed.order_intent.product_quantities;\n  if (items && Array.isArray(items)) {\n    parsed.order_intent = items.map(i => `${i.quantity} ${i.product}`).join(', ');\n  } else {\n    parsed.order_intent = JSON.stringify(parsed.order_intent);\n  }\n}\n\nreturn [{ \n  json: {\n    ...parsed,\n    action_items_json: JSON.stringify(parsed.action_items),\n    missing_fields_json: JSON.stringify(parsed.missing_fields)\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -48
      ],
      "id": "52e79716-6b60-4c0d-9c93-8bc61263b607",
      "name": "Extract LLM Format"
    },
    {
      "parameters": {
        "jsCode": "const data = $('Extract LLM Format').item.json;\nconst transcript = $('Webhook').item.json.body.transcript.replace(/'/g, \"''\");\nconst accountName = data.account_name.replace(/'/g, \"''\");\nconst contactName = data.contact_name.replace(/'/g, \"''\");\nconst summary = (data.summary || '').replace(/'/g, \"''\");\nconst orderIntent = (data.order_intent && typeof data.order_intent === 'string')\n  ? `'\"${data.order_intent.replace(/'/g, \"''\").replace(/\"/g, '\\\\\"')}\"'::jsonb`\n  : 'NULL';\nconst actionItems = JSON.stringify(data.action_items);\nconst missingFields = JSON.stringify(data.missing_fields);\nconst reviewedBy = $('Send an Email').first().json.accepted[0];\nconst extractionModel = $('HTTP Request').first().json.model;\n\nconst query = `INSERT INTO sales.call_records (\n  account_name,\n  contact_name,\n  summary,\n  action_items,\n  order_intent,\n  missing_fields,\n  needs_followup,\n  review_status,\n  reviewed_by,\n  raw_transcript,\n  extraction_model\n) VALUES (\n  '${accountName}',\n  '${contactName}',\n  '${summary}',\n  '${actionItems}'::jsonb,\n  ${orderIntent},\n  '${missingFields}'::jsonb,\n  ${data.needs_followup},\n  'approved',\n  '${reviewedBy}',\n  '${transcript}',\n  '${extractionModel}'\n)`;\n\nreturn [{ json: { query } }];\n"
      },
